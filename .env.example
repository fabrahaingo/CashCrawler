# Bank Data Aggregator - Environment Configuration
# Copy this file to .env and fill in your credentials

# =============================================================================
# Caisse d'Épargne
# =============================================================================
# Your user identifier (the number you use to log in)
CE_USERNAME=your_user_id

# Your password (digits only, no spaces)
CE_PASSWORD=your_password

# =============================================================================
# UAF Life Patrimoine (optional)
# =============================================================================
UAF_USERNAME=your_user_id
UAF_PASSWORD=your_password

# =============================================================================
# Bourse Direct (optional)
# =============================================================================
BOURSE_DIRECT_USERNAME=your_user_id
BOURSE_DIRECT_PASSWORD=your_password

# =============================================================================
# Sumeria (optional) — phone in international format, OTP from the mobile app
# =============================================================================
SUMERIA_PHONE=+33XXXXXXXXX

# =============================================================================
# Swile (optional) — meal vouchers. First run emails a 6-digit code;
# device trust is then cached so later runs need no code. Set SWILE_OTP
# to run non-interactively on the first login.
# =============================================================================
SWILE_USERNAME=your_email
SWILE_PASSWORD=your_password
