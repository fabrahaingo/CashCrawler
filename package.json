{
  "name": "cashcrawler",
  "version": "1.0.0",
  "description": "Self-hosted bank data crawler - download your own financial data",
  "main": "index.js",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "ce:balances": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/caisse-epargne/index.ts balances",
    "ce:transactions": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/caisse-epargne/index.ts transactions",
    "uaf:balances": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/uaf-life/index.ts balances",
    "uaf:transactions": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/uaf-life/index.ts transactions",
    "bourse-direct:balances": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/bourse-direct/index.ts balances",
    "bourse-direct:transactions": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/bourse-direct/index.ts transactions",
    "sumeria:balances": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/sumeria/index.ts balances",
    "sumeria:transactions": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/sumeria/index.ts transactions",
    "swile:balances": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/swile/index.ts balances",
    "swile:transactions": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/swile/index.ts transactions",
    "ce:discover": "DEBUG_BROWSER=1 NODE_NO_WARNINGS=1 npx tsx ./src/connectors/caisse-epargne/index.ts discover",
    "ce:all": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/caisse-epargne/index.ts all",
    "uaf:all": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/uaf-life/index.ts all",
    "bourse-direct:all": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/bourse-direct/index.ts all",
    "sumeria:all": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/sumeria/index.ts all",
    "swile:all": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/swile/index.ts all",
    "yahoo:prices": "NODE_NO_WARNINGS=1 npx tsx ./src/connectors/yahoo/index.ts",
    "all": "NODE_NO_WARNINGS=1 npx tsx ./src/run-all.ts"
  },
  "keywords": [
    "bank",
    "finance",
    "scraper",
    "self-hosted",
    "privacy"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.2.3",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
